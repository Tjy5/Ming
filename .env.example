# 本游戏无内置 Mock 供应商——必须配置真实的 AI 供应商（API Key 等）才能游玩。
# 推荐直接在游戏内「AI 设置」页面配置（无需手改本文件）。
AI_PROVIDER=openai
OPENAI_TRUST_ENV_PROXY=0

# OpenAI-compatible provider example:
# OPENAI_API_KEY=your_api_key
# OPENAI_BASE_URL=https://example.com/v1
# OPENAI_MODEL_NAME=your_model
# OPENAI_SIMPLE_MODEL=your_model
#
# If your provider gives a full /v1/chat/completions URL, use the /v1 base
# URL here. The in-app AI settings page also normalizes this automatically.

# Admin access (required for /admin page):
# ADMIN_PASSWORD=your_admin_password

# Optional for AI_PROVIDER=Z:
# Z_ENABLE_THINKING_DEFAULT=0
# Z_ENABLE_THINKING_TASKS=generate_debate_narrative,generate_memorial,generate_assembly_debate
#
# Optional per-task sampling overrides (OpenAI-compatible providers):
# Priority (high -> low):
# 1) {PREFIX}_{TASK}_TEMPERATURE / {PREFIX}_{TASK}_TOP_P
# 2) AI_{TASK}_TEMPERATURE / AI_{TASK}_TOP_P
# 3) {PREFIX}_TEMPERATURE / {PREFIX}_TOP_P
# 4) AI_TEMPERATURE / AI_TOP_P
#
# Example for Z:
# Z_PARSE_FREE_INPUT_TEMPERATURE=0.2
# Z_PARSE_FREE_INPUT_TOP_P=0.9
#
# Optional global timeout/retry for non-task-specific calls:
# AI_TIMEOUT=20
# AI_RETRIES=2
#
# Optional task-specific timeout/retry:
# AI_PARSE_TIMEOUT=20
# AI_PARSE_RETRIES=1
# AI_FREEFORM_TIMEOUT=35
# AI_FREEFORM_RETRIES=1
# AI_TURN_COMMENTARY_TIMEOUT=20
# AI_TURN_COMMENTARY_RETRIES=1
