{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "generate-types": "openapi-typescript http://localhost:8000/openapi.json -o src/types/generated.ts --export-type",
    "check-generated-types": "openapi-typescript http://localhost:8000/openapi.json -o src/types/generated.ts --export-type --check",
    "type-check": "npm run check-generated-types && tsc -b",
    "test": "vitest run --exclude e2e/**",
    "test:e2e": "node ../scripts/run-lifecycle-e2e.mjs",
    "test:e2e:live": "node ../scripts/run-release-smoke.mjs",
    "release:gate": "node ../scripts/release-smoke-gate.mjs"
  },
  "dependencies": {
    "framer-motion": "^12.34.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.9.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^30.0.1",
    "openapi-typescript": "^7.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
